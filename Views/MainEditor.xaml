<?xml version="1.0" encoding="utf-8" ?>
<Grid
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BookIt.Controls"
    x:Class="BookIt.Views.MainEditor"
    Background="White"
    x:Name="EditorGrid">

        <Grid>
            <Grid.Resources>
                <Style TargetType="controls:RichTextEditor" />
            </Grid.Resources>
            <controls:RichTextEditor x:Name="RichEditor"
                                                             Document="{Binding Document, Mode=TwoWay}" />
        </Grid>

</Grid>
