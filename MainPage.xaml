<Page x:Class="BookIt.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:BookIt"
      xmlns:views="using:BookIt.Views"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

  <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="300,*,300">

    <!-- Menu and Toolbar Row -->
    <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Orientation="Vertical" Background="#F0F0F0">
      <!-- Menu -->
      <StackPanel Orientation="Horizontal" Padding="10" Spacing="15" Background="#FFFFFF" BorderThickness="0,0,0,1" BorderBrush="#E0E0E0">
        <TextBlock Text="File" FontSize="12" />
        <TextBlock Text="Edit" FontSize="12" />
        <TextBlock Text="View" FontSize="12" />
        <TextBlock Text="Tools" FontSize="12" />
        <TextBlock Text="Help" FontSize="12" />
      </StackPanel>
      
      <!-- Toolbar -->
      <StackPanel Orientation="Horizontal" Padding="10" Spacing="5" Background="#F0F0F0" BorderThickness="0,0,0,1" BorderBrush="#E0E0E0">
        <TextBlock Text="[New]" FontSize="12" Foreground="Gray" />
        <TextBlock Text="[Open]" FontSize="12" Foreground="Gray" />
        <TextBlock Text="[Save]" FontSize="12" Foreground="Gray" />
        <Separator />
        <TextBlock Text="[Cut]" FontSize="12" Foreground="Gray" />
        <TextBlock Text="[Copy]" FontSize="12" Foreground="Gray" />
        <TextBlock Text="[Paste]" FontSize="12" Foreground="Gray" />
      </StackPanel>
    </StackPanel>

    <!-- Left Panel -->
    <Grid Grid.Row="1" Grid.Column="0" Background="#F5F5F5" MinWidth="200" BorderThickness="0,0,1,0" BorderBrush="#D0D0D0">
      <views:LeftPanel />
    </Grid>

    <!-- Main Editor -->
    <Grid Grid.Row="1" Grid.Column="1" Background="White" BorderThickness="0,0,1,0" BorderBrush="#D0D0D0">
      <views:MainEditor x:Name="MainEditorControl" />
    </Grid>

    <!-- Right Panel -->
    <Grid Grid.Row="1" Grid.Column="2" Background="#F5F5F5" MinWidth="200">
      <views:RightPanel />
    </Grid>

    <!-- Message Panel (Bottom) -->
    <Grid Grid.Row="2" Grid.ColumnSpan="3" Background="#E8E8E8" BorderThickness="0,1,0,0" BorderBrush="#C0C0C0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      
      <views:MessagePanel Grid.Row="0" />
      
      <views:StatusBar Grid.Row="1" />
    </Grid>

  </Grid>

</Page>
