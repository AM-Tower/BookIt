#!/bin/sh
# Pre-push hook: ensure project builds before allowing push

echo "Running pre-push build checks..."
if command -v dotnet >/dev/null 2>&1; then
  echo "Building net10.0-desktop..."
  if ! dotnet build ./BookIt.csproj -c Debug -f net10.0-desktop; then
    echo "Desktop build failed. Aborting push."
    exit 1
  fi
  echo "Building browser wasm (quick)..."
  if ! dotnet build ./BookIt.csproj -c Debug -f net10.0-browserwasm; then
    echo "Browser wasm build failed. Aborting push."
    exit 1
  fi
  echo "Build checks passed."
  exit 0
else
  echo "dotnet not found; skipping build checks"
  exit 0
fi
